# Copy this file to .env and put your local SQL Server login in the connection string.
# Docker Desktop reaches the Windows host as host.docker.internal.
# The API containers are Linux, so Windows Authentication does not work here. Use a SQL login.
WALLET_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DiaWallet;User Id=sa;Password=Your_password;TrustServerCertificate=True;Encrypt=True;Connect Timeout=30
